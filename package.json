{
    "name": "gantt-chart-visual",
    "description": "Atlyn Gantt Chart for Power BI",
    "version": "1.0.4.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/garrett-hamers/powerbi-gantt-chart"
    },
    "license": "MIT",
    "scripts": {
        "pbiviz": "pbiviz",
        "start": "pbiviz start",
        "clean:package": "node -e \"for(const path of ['dist','.tmp'])require('fs').rmSync(path,{recursive:true,force:true})\"",
        "package": "npm run clean:package && pbiviz package --certification-audit",
        "eslint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
        "lint": "npm run eslint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:visual:build": "node -e \"require('fs').mkdirSync('.tmp',{recursive:true})\" && npx lessc style/visual.less .tmp/visual-harness.css && npx esbuild test/visual-harness-entry.ts --bundle --outfile=.tmp/visual-harness-bundle.js --format=iife --target=es2020 --loader:.less=empty",
        "test:visual": "npm run test:visual:build && npx playwright test --config=playwright.config.ts",
        "test:visual:update": "npm run test:visual:build && npx playwright test --config=playwright.config.ts --update-snapshots",
        "validate:certification": "npm audit --audit-level=moderate && npm run eslint && npx tsc --noEmit && npm test && npm run test:visual && npm run package"
    },
    "dependencies": {
        "d3-axis": "3.0.0",
        "d3-scale": "4.0.2",
        "d3-selection": "3.0.0",
        "powerbi-models": "2.0.1",
        "powerbi-visuals-api": "5.11.1",
        "powerbi-visuals-utils-formattingmodel": "7.1.0",
        "powerbi-visuals-utils-formattingutils": "6.1.2"
    },
    "devDependencies": {
        "@playwright/test": "1.61.1",
        "@types/d3-axis": "3.0.6",
        "@types/d3-scale": "4.0.9",
        "@types/d3-selection": "3.0.11",
        "esbuild": "0.28.1",
        "eslint": "9.39.5",
        "eslint-plugin-powerbi-visuals": "1.1.1",
        "happy-dom": "20.11.0",
        "http-server": "14.1.1",
        "less": "4.6.4",
        "powerbi-visuals-tools": "7.2.0",
        "typescript": "5.9.3",
        "vitest": "4.1.10"
    },
    "overrides": {
        "@hono/node-server@<2.0.10": "2.0.11",
        "ajv@<6.14.0": "6.14.0",
        "brace-expansion@<1.1.16": "1.1.16",
        "flatted@<=3.4.1": "3.4.2",
        "follow-redirects@<=1.15.11": "1.16.0",
        "js-yaml@>=4.0.0 <4.1.2": "4.1.2",
        "minimatch@<=3.1.3": "3.1.4",
        "picomatch@>=4.0.0 <=4.0.3": "4.0.5",
        "postcss@<8.5.10": "8.5.20",
        "uuid@<11.1.1": "11.1.1",
        "ws@>=8.0.0 <=8.20.1": "8.21.1"
    }
}
