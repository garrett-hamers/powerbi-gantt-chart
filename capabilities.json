{
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "supportsHighlight": true,
    "supportsKeyboardFocus": true,
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": ["tooltips"],
        "supportEnhancedTooltips": true
    },
    "dataRoles": [
        {
            "displayName": "Task",
            "displayNameKey": "Role_Task",
            "name": "task",
            "kind": "Grouping",
            "description": "Task name"
        },
        {
            "displayName": "Task ID",
            "displayNameKey": "Role_TaskId",
            "name": "taskId",
            "kind": "Grouping",
            "description": "Optional stable identifier used to validate task identity"
        },
        {
            "displayName": "Start Date",
            "name": "startDate",
            "kind": "Measure",
            "description": "Task start date"
        },
        {
            "displayName": "End Date",
            "name": "endDate",
            "kind": "Measure",
            "description": "Task end date"
        },
        {
            "displayName": "Progress",
            "name": "progress",
            "kind": "Measure",
            "description": "Completion percentage (0-100)"
        },
        {
            "displayName": "Category",
            "name": "category",
            "kind": "Grouping",
            "description": "Group/phase for color coding"
        },
        {
            "displayName": "Tooltips",
            "name": "tooltips",
            "kind": "Measure",
            "description": "Additional measures to show in tooltips"
        }
    ],
    "objects": {
        "general": {
            "properties": {
                "filter": {
                    "type": { "filter": true }
                }
            }
        },
        "chartSettings": {
            "properties": {
                "showTodayLine": {
                    "type": { "bool": true }
                },
                "showGridLines": {
                    "type": { "bool": true }
                },
                "progressInterpretation": {
                    "type": {
                        "enumeration": [
                            { "value": "auto", "displayName": "Auto" },
                            { "value": "fraction", "displayName": "Fraction (0 to 1)" },
                            { "value": "percent", "displayName": "Percent (0 to 100)" }
                        ]
                    }
                },
                "reversedDateHandling": {
                    "type": {
                        "enumeration": [
                            { "value": "correct", "displayName": "Correct and warn" },
                            { "value": "exclude", "displayName": "Exclude and warn" }
                        ]
                    }
                },
                "barHeight": {
                    "type": { "numeric": true }
                },
                "barCornerRadius": {
                    "type": { "numeric": true }
                }
            }
        },
        "title": {
            "properties": {
                "show": {
                    "type": { "bool": true }
                },
                "titleText": {
                    "type": { "text": true }
                },
                "fontSize": {
                    "type": { "numeric": true }
                },
                "fontColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "alignment": {
                    "type": {
                        "enumeration": [
                            { "value": "left", "displayName": "Left" },
                            { "value": "center", "displayName": "Center" },
                            { "value": "right", "displayName": "Right" }
                        ]
                    }
                }
            }
        },
        "dataLabels": {
            "properties": {
                "show": {
                    "type": { "bool": true }
                },
                "fontSize": {
                    "type": { "numeric": true }
                },
                "showProgress": {
                    "type": { "bool": true }
                }
            }
        },
        "categories": {
            "properties": {
                "show": {
                    "type": { "bool": true }
                },
                "fontSize": {
                    "type": { "numeric": true }
                },
                "fontColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                }
            }
        },
        "design": {
            "properties": {
                "categoryColor1": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "categoryColor2": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "categoryColor3": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "categoryColor4": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "categoryColor5": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "categoryColor6": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "categoryColor7": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "categoryColor8": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "categoryColor9": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "categoryColor10": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "progressColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "todayLineColor": {
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "barOpacity": {
                    "type": { "numeric": true }
                }
            }
        },
        "interaction": {
            "properties": {
                "enableSelection": {
                    "type": { "bool": true }
                },
                "enableTooltips": {
                    "type": { "bool": true }
                },
                "crossFilterMode": {
                    "type": {
                        "enumeration": [
                            { "value": "highlight", "displayName": "Highlight" },
                            { "value": "filter", "displayName": "Filter" }
                        ]
                    }
                }
            }
        },
        "legend": {
            "properties": {
                "show": {
                    "type": { "bool": true }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "task": { "max": 1 },
                    "taskId": { "max": 1 },
                    "startDate": { "max": 1 },
                    "endDate": { "max": 1 },
                    "progress": { "max": 1 },
                    "category": { "max": 1 }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        { "for": { "in": "task" } },
                        { "for": { "in": "taskId" } },
                        { "for": { "in": "category" } }
                    ],
                    "dataReductionAlgorithm": { "top": { "count": 5000 } }
                },
                "values": {
                    "select": [
                        { "bind": { "to": "startDate" } },
                        { "bind": { "to": "endDate" } },
                        { "bind": { "to": "progress" } },
                        { "for": { "in": "tooltips" } }
                    ]
                }
            }
        }
    ],
    "privileges": []
}
